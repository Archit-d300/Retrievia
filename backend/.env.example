# Hugging Face access token (https://huggingface.co/settings/tokens, "Inference Providers" permission)
HF_TOKEN=

# Small, non-"thinking" instruct model => fewest output tokens. Any chat model on HF Inference Providers works.
HF_LLM_MODEL=Qwen/Qwen3-4B-Instruct-2507
# Optional: separate (even smaller) model for the retrieval grader. Defaults to HF_LLM_MODEL.
# HF_GRADER_MODEL=LiquidAI/LFM2.5-350M
HF_PROVIDER=auto

# Embeddings: "local" runs the 350M model on your CPU/GPU (sentence-transformers), "api" uses Inference Providers.
HF_EMBED_MODEL=LiquidAI/LFM2.5-Embedding-350M
EMBED_MODE=local

# Retrieval grading gates (cosine). >= HIGH is auto-relevant, < LOW is auto-irrelevant, in-between goes to the LLM grader.
GRADE_HIGH=0.55
GRADE_LOW=0.25
